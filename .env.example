# Required for production session cookies (use a random value of 32+ characters).
SESSION_SECRET=replace-with-a-random-32-character-secret
# Invitation-only beta works without email verification or an email service.
# The code is server-only: never use VITE_ prefix or include it in screenshots/logs.
# Missing invitation with private mode closes registration, without stopping the app.
BETA_MODE=off
BETA_INVITE_CODE=
# When off, public production signup still requires operator, mail and bot settings.
# Beta admission is not a verified email. Before disabling beta, enable verification
# and let invited users confirm their own email addresses.
# Optional passwordless shortcut for a configured EXISTING owner/admin account.
# Disabled by default. Server permits it only in NODE_ENV=development on loopback,
# with same-origin requests and without forwarded/proxy headers. Never enable on a
# shared development host. Production rejects it even if enabled accidentally.
ENABLE_LOCAL_ADMIN_LOGIN=false
LOCAL_ADMIN_USER_ID=
LOCAL_ADMIN_WORKSPACE_ID=
# Runtime values are normally injected by the production host. Leave these
# commented for `npm run dev`; production should set NODE_ENV explicitly.
# NODE_ENV=production
# PORT=3000
# HOST=0.0.0.0
# PostgreSQL is the default. Opt into JSON only for isolated development fixtures.
MARKETINGPILOT_JSON_FIXTURE=false
# Fixture storage directory. PostgreSQL is selected automatically when
# DATABASE_URL or DIRECT_URL is configured.
MARKETINGPILOT_DATA_DIR=./data
# Local development preserves data/media. Vercel must use a private Blob store;
# its integration injects BLOB_STORE_ID / BLOB_READ_WRITE_TOKEN securely.
MEDIA_STORAGE=local
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Optional private backup import, only as an explicit authorized release step.
# Builds never import snapshots automatically.
# Format: migrations/marketingpilot-<sha256>.json. Never upload JSON to GitHub.
MARKETINGPILOT_IMPORT_BLOB_PATH=
# Standard PostgreSQL connection strings. Use DATABASE_URL for the app runtime
# (pooler is fine) and DIRECT_URL for schema migrations when your provider has
# a direct connection endpoint (for example Supabase).
DATABASE_URL=
DIRECT_URL=
# Optional Neon/Vercel integration alias used by the Vercel build runner.
DATABASE_URL_UNPOOLED=
# Set to require for managed PostgreSQL providers that require TLS.
DATABASE_SSL=require
DATABASE_POOL_MAX=10
# Builds never migrate by default. Prefer an explicit `npm run db:migrate` step.
# Optional preview ONLY: preview-isolated, with two verified Neon endpoint/database
# SHA256 pins (no credentials in the hash). Production must leave this empty.
MIGRATE_ON_BUILD=
PREVIEW_DATABASE_TARGET_SHA256=
PRODUCTION_DATABASE_TARGET_SHA256=
# UTC calendar day; every provider attempt counts, including retries and failures.
AI_DAILY_CALL_LIMIT=100
# OpenRouter server-side API key. Never expose this in client code.
OPENROUTER_API_KEY=
# Optional model overrides; defaults support structured JSON and image output.
OPENROUTER_TEXT_MODEL=openai/gpt-4.1-mini
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2.5-sunburst
# Optional text provider switch for server-side post generation. Defaults to OpenRouter.
# Gemini uses its OpenAI-compatible API; the image endpoint remains on OpenRouter.
AI_TEXT_PROVIDER=openrouter
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite

# Optional server-side photo video rendering overrides. Local Node development
# uses ffmpeg-static and an installed Arial/DejaVu font automatically.
# Production requires a Node server (not Cloudflare Workers), the installed
# ffmpeg-static package or an explicit absolute FFmpeg path, and a TTF font.
FFMPEG_PATH=
VIDEO_FONT_PATH=

# Meta Graph / OAuth (server-only; never use VITE_* for these values)
# This exact URI must also be registered in the Meta Developer dashboard.
META_APP_ID=
META_APP_SECRET=
# Set this to the exact registered HTTPS callback in production.
# Local development example: http://localhost:8080/api/channels/oauth-callback
META_REDIRECT_URI=
META_GRAPH_VERSION=v26.0
META_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,instagram_basic,instagram_content_publish
# Public HTTPS origin used to let Meta fetch Instagram media during publishing.
PUBLIC_APP_URL=
# Intentionally public operator details, returned only by an explicit whitelist.
# Leave empty until the operator supplies verified details; no invented contact.
PUBLIC_OPERATOR_NAME=
PUBLIC_OPERATOR_ADDRESS=
PUBLIC_CONTACT_EMAIL=
PUBLIC_OPERATOR_ABOUT=
# Optional public origin override for media URLs.
MEDIA_PUBLIC_BASE_URL=

# AES-256-GCM key for server-side channel tokens (required in production; use a random 32+ byte value)
CHANNEL_TOKEN_ENCRYPTION_KEY=

# Closed beta: production registration fails closed without these service/operator settings.
OPERATOR_NAME=
OPERATOR_EMAIL=
OPERATOR_ADDRESS=
RESEND_API_KEY=
EMAIL_FROM=
# Daily server-only operational monitoring; Vercel injects this bearer secret.
# Use a separate random secret of at least 32 characters, never a public variable.
CRON_SECRET=
AI_MONITOR_CREDITS_THRESHOLD_USD=5
AI_MONITOR_402_THRESHOLD=1
AI_MONITOR_429_THRESHOLD=10
AI_MONITOR_TIMEOUT_THRESHOLD=5
# Optional ONLY when account /credits access requires a management key.
# Without it, the existing key's finite remaining budget is used. If neither
# endpoint exposes a budget, monitoring reports CREDIT_CHECK_UNAVAILABLE.
OPENROUTER_MANAGEMENT_API_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional dedicated Vercel Preview fixture. Never enable for production users.
# Requires NON-production NODE_ENV, VERCEL_ENV=preview, PostgreSQL and a TESZT
# account/brand. Production-built Vercel Previews must use real AI instead.
MARKETINGPILOT_PREVIEW_TEST_AI=false
MARKETINGPILOT_PREVIEW_TEST_EMAIL=
# PUBLIC_APP_URL must be the canonical HTTPS origin in production.
## Heti emlékeztető: csak felhasználói bekapcsolás után, megerősített címekre.
## A meglévő napi Cron hétfői futása küldi; Resend + EMAIL_FROM + SESSION_SECRET szükséges.
WEEKLY_REMINDERS_ENABLED=false
WEEKLY_REMINDER_TIMEZONE=Europe/Bucharest

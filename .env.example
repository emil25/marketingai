# Required for production session cookies (use a random value of 32+ characters).
SESSION_SECRET=replace-with-a-random-32-character-secret
# Optional passwordless shortcut for a configured EXISTING owner/admin account.
# Disabled by default. Server permits it only in NODE_ENV=development on loopback,
# with same-origin requests and without forwarded/proxy headers. Never enable on a
# shared development host. Production rejects it even if enabled accidentally.
ENABLE_LOCAL_ADMIN_LOGIN=false
LOCAL_ADMIN_USER_ID=
LOCAL_ADMIN_WORKSPACE_ID=
# Runtime values are normally injected by the production host. Leave these
# commented for `npm run dev`; production should set NODE_ENV explicitly.
# NODE_ENV=production
# PORT=3000
# HOST=0.0.0.0
# Local fallback storage directory. PostgreSQL is selected automatically when
# DATABASE_URL or DIRECT_URL is configured.
MARKETINGPILOT_DATA_DIR=./data
# Local development preserves data/media. Vercel must use a private Blob store;
# its integration injects BLOB_STORE_ID / BLOB_READ_WRITE_TOKEN securely.
MEDIA_STORAGE=local
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Optional one-time private backup import during authorized Vercel builds.
# Format: migrations/marketingpilot-<sha256>.json. Never upload JSON to GitHub.
MARKETINGPILOT_IMPORT_BLOB_PATH=
# Standard PostgreSQL connection strings. Use DATABASE_URL for the app runtime
# (pooler is fine) and DIRECT_URL for schema migrations when your provider has
# a direct connection endpoint (for example Supabase).
DATABASE_URL=
DIRECT_URL=
# Set to require for managed PostgreSQL providers that require TLS.
DATABASE_SSL=require
DATABASE_POOL_MAX=10
# OpenRouter server-side API key. Never expose this in client code.
OPENROUTER_API_KEY=
# Optional model overrides; defaults support structured JSON and image output.
OPENROUTER_TEXT_MODEL=openai/gpt-4.1-mini
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2.5-sunburst

# Optional server-side photo video rendering overrides. Local Node development
# uses ffmpeg-static and an installed Arial/DejaVu font automatically.
# Production requires a Node server (not Cloudflare Workers), the installed
# ffmpeg-static package or an explicit absolute FFmpeg path, and a TTF font.
FFMPEG_PATH=
VIDEO_FONT_PATH=

# Meta Graph / OAuth (server-only; never use VITE_* for these values)
# This exact URI must also be registered in the Meta Developer dashboard.
META_APP_ID=
META_APP_SECRET=
# Set this to the exact registered HTTPS callback in production.
# Local development example: http://localhost:8080/api/channels/oauth-callback
META_REDIRECT_URI=
META_GRAPH_VERSION=v26.0
META_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,instagram_basic,instagram_content_publish
# Public HTTPS origin used to let Meta fetch Instagram media during publishing.
PUBLIC_APP_URL=
# Optional public origin override for media URLs.
MEDIA_PUBLIC_BASE_URL=

# AES-256-GCM key for server-side channel tokens (required in production; use a random 32+ byte value)
CHANNEL_TOKEN_ENCRYPTION_KEY=
